@using ECommerceApp.Domain.DTOs.Product.ProductDiscount
@using ECommerceApp.Domain.DTOs.Product.ProductDiscount
@model FilterProductDiscountDto

@{
    ViewData["Title"] = "تخفیفات";
}

<div class="nk-content nk-content-fluid">
    <div class="container-xl wide-xl">
        <div class="nk-content-body">
            <div class="nk-block-head nk-block-head-sm">
                <div class="nk-block-between">
                    <div class="nk-block-head-content">
                        <h3 class="nk-block-title page-title">@ViewData["Title"]</h3>
                    </div>
                    <!-- .nk-block-head-content -->
                    <div class="nk-block-head-content">
                        <div class="toggle-wrap nk-block-tools-toggle">
                            <div class="toggle-expand-content">
                                <ul class="nk-block-tools g-3">
                                    <li class="nk-block-tools-opt">
                                        <a asp-area="Administration" asp-controller="Product" asp-action="CreateProductDiscount" asp-route-productId="@Model.ProductId" class="btn btn-primary"><em class="icon ni ni-plus"></em><span>افزودن تخفیف</span></a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- .nk-block-head-content -->
                </div>
                <!-- .nk-block-between -->
            </div>
            @if (Model.ProductDiscounts is not null && Model.ProductDiscounts.Any())
            {
                <!-- .nk-block-head -->
                <div class="nk-block">
                    <div class="card">
                        <div class="card-inner-group">
                            <div class="card-inner p-0">
                                <div class="nk-tb-list">
                                    <div class="nk-tb-item nk-tb-head">
                                        <div class="nk-tb-col"><span></span>‌‌شناسه</div>
                                        <div class="nk-tb-col"><span>درصد</span></div>
                                        <div class="nk-tb-col"><span></span>‌‌تاریخ انقضا</div>
                                        <div class="nk-tb-col"><span></span>‌‌ظرفیت</div>
                                        <div class="nk-tb-col"><span></span>‌‌ایجاد شده در</div>
                                        <div class="nk-tb-col"><span></span>‌آخرین به روزرسانی در</div>
                                        <div class="nk-tb-col"><span>وضعیت</span></div>
                                        <div class="nk-tb-col"><span>اقدام</span></div>
                                    </div>
                                    <!-- .nk-tb-item -->
                                    @foreach (var productDiscount in Model.ProductDiscounts)
                                    {
                                        <div class="nk-tb-item">
                                            <div class="nk-tb-col">
                                                <span class="tb-sub">@productDiscount.Id</span>
                                            </div>
                                            <div class="nk-tb-col">
                                                <span class="tb-sub">@productDiscount.Percentage%</span>
                                            </div>
                                            <div class="nk-tb-col">
                                                <span class="tb-sub">@productDiscount.ExpireDate</span>
                                            </div>
                                            <div class="nk-tb-col">
                                                <span class="tb-sub">@productDiscount.DiscountNumber نفر</span>
                                            </div>
                                            <div class="nk-tb-col">
                                                <span class="tb-sub">@productDiscount.CreatedAt.ToString() | @productDiscount.CreatedBy</span>
                                            </div>
                                            <div class="nk-tb-col">
                                                <span class="tb-sub">@productDiscount.LastModifiedAt.ToString() | @productDiscount.Modifiedby</span>
                                            </div>
                                            <div class="nk-tb-col">
                                                @if (productDiscount.IsPublished)
                                                {
                                                    <span class="tb-sub text-success">فعال</span>
                                                }
                                                else
                                                {
                                                    <span class="tb-sub text-danger">غیرفعال</span>
                                                }
                                            </div>
                                            <div class="nk-tb-col nk-tb-col-tools">
                                                <ul class="nk-tb-actions gx-1 my-n1">
                                                    <li class="me-n1">
                                                        <div class="dropdown">
                                                            <a href="#" class="dropdown-toggle btn btn-icon btn-trigger" data-bs-toggle="dropdown" aria-expanded="false"><em class="icon ni ni-more-h"></em></a>
                                                            <div class="dropdown-menu dropdown-menu-end" style="">
                                                                <ul class="link-list-opt no-bdr">
                                                                    <li>
                                                                        <a asp-area="Administration"
                                                                           asp-controller="Product"
                                                                           asp-action="EditProductDiscount"
                                                                           asp-route-id="@productDiscount.Id"><em class="icon ni ni-edit"></em><span>ویرایش</span></a>
                                                                    </li>
                                                                    <li>

                                                                        <a asp-area="Administration"
                                                                           asp-controller="Product"
                                                                           asp-action="@(productDiscount.IsPublished ? "UnpublishProductCategory" : "RepublishProductCategory")"
                                                                           asp-route-id="@productDiscount.Id">
                                                                            <em class="icon ni ni-trash"></em><span>@(productDiscount.IsPublished ? "غیرفعال کردن " : "فعال کردن")</span>
                                                                        </a>

                                                                    </li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <!-- .nk-tb-list -->
                            </div>
                            <partial name="_AdminPagingPartial" model="Model.GetCurrentPaging()" />
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="nk-block">
                    <partial name="NoItemFound" />
                </div>
            }
        </div>
    </div>
</div>
