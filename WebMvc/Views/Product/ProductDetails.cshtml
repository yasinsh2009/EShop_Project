@using ECommerceApp.Application.Utilities
@using ECommerceApp.Domain.DTOs.Product
@model ProductDetailsDto

@{
    ViewData["Title"] = Model.Title;
}

<section class="content">
    <div class="bread-crumb py-0 mb-3">
