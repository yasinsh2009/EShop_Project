@model EShop.Domain.DTOs.Product.ProductDiscount.CreateProductDiscountDto


@{
    ViewData["Title"] = "افزودن تخفیف محصول جدید";
}

<div class="nk-content nk-content-fluid">
    <div class="container-xl wide-xl">
        <div class="nk-content-body">
            <div class="components-preview wide-xl mx-auto">
                <!-- .nk-block-head -->
                <div class="nk-block nk-block-lg">
                    <div class="nk-block-head">
                        <div class="nk-block-head-content">
                            <h4 class="title nk-block-title">@ViewData["Title"]</h4>
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-inner">
                            <form asp-area="Administration" asp-controller="Product" asp-action="CreateProductDiscount" method="post" id="filter-form">
                                <div class="row g-gs">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">درصد</label>
                                            <div class="form-control-wrap">
                                                <input asp-for="Percentage" type="number" class="form-control">
                                                <span asp-validation-for="Percentage" class="invalid"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label">تاریخ انقضا</label>
                                            <div class="form-control-wrap">
                                                <input asp-for="ExpireDate" type="date" class="form-control">
                                                <span asp-validation-for="ExpireDate" class="invalid"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label class="form-label">‌ظرفیت</label>
                                            <div class="form-control-wrap">
                                                <input asp-for="DiscountNumber" type="number" class="form-control">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <button type="submit" class="btn btn-lg btn-primary">ذخیره اطلاعات</button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- .nk-block -->
            </div>
            <!-- .components-preview -->
        </div>
    </div>
</div>